{
  "name": "digital-distribution-os",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "SKIP_ENV_VALIDATION=1 tsx --test src/authz/can.test.ts src/shared/errors.test.ts src/lib/api-error.test.ts src/lib/http.test.ts src/agents/critic/scoring.test.ts src/agents/platforms/compose.test.ts src/agents/platforms/linkedin-rules.test.ts src/creative/slides.test.ts src/creative/fit-image.test.ts src/creative/image-prompt.test.ts src/tools/social/bluesky.test.ts src/tools/social/linkedin.test.ts src/tools/tavily.test.ts src/tools/llm.retry.test.ts",
    "test:db": "node --import ./scripts/load-env.mjs --import tsx --test src/db/queries/scope.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --import ./scripts/load-env.mjs ./node_modules/drizzle-kit/bin.cjs migrate",
    "db:push": "node --import ./scripts/load-env.mjs ./node_modules/drizzle-kit/bin.cjs push",
    "db:seed": "node --import ./scripts/load-env.mjs --import tsx src/db/seed.ts",
    "db:studio": "node --import ./scripts/load-env.mjs ./node_modules/drizzle-kit/bin.cjs studio",
    "context:print": "node --import ./scripts/load-env.mjs --import tsx scripts/print-context.ts",
    "campaign:test": "node --import ./scripts/load-env.mjs --import tsx scripts/run-campaign.ts",
    "bootstrap-owner": "node --import ./scripts/load-env.mjs --import tsx scripts/bootstrap-owner.ts",
    "bootstrap-demo-users": "node --import ./scripts/load-env.mjs --import tsx scripts/bootstrap-demo-users.ts",
    "deploy": "bash ./scripts/deploy.sh"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.75",
    "@ai-sdk/groq": "^4.0.45",
    "@atproto/api": "^0.20.44",
    "@base-ui/react": "^1.8.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.109.0",
    "ai": "^7.0.106",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.47.0",
    "next": "16.3.5",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "sharp": "^0.35.4",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
