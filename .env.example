# Public origin used for redirects and same-origin checks on mutating APIs.
APP_URL=http://localhost:3000

# Supabase project (API) — Project Settings → API
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Postgres (Drizzle) — Project Settings → Database → Connection string (URI).
# Use the Session / Direct connection for `npm run db:migrate`.
# The Transaction pooler URL is fine for the Next.js app at runtime.
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Vercel AI SDK providers
GOOGLE_GENERATIVE_AI_API_KEY=
GROQ_API_KEY=

# Model ids (never hard-coded in source — set them here)
WRITER_MODEL=gemini-3.5-flash-lite
CRITIC_MODEL=openai/gpt-oss-20b

# Bluesky publishing — create an app password at bsky.app → Settings → App Passwords
BLUESKY_HANDLE=yourhandle.bsky.social
BLUESKY_APP_PASSWORD=

# Optional. Shared password for `npm run bootstrap-demo-users`.
# Default (if unset): Loopwave-demo-1
# DEMO_PASSWORD=
