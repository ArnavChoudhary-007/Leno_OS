# Public origin used for redirects and same-origin checks on mutating APIs.
APP_URL=http://localhost:3000

# Supabase project (API) — Project Settings → API
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Postgres (Drizzle) — Project Settings → Database → Connection string (URI).
# Use the Session / Direct connection for `npm run db:migrate`.
# The Transaction pooler URL is fine for the Next.js app at runtime.
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Vercel AI SDK providers
GOOGLE_GENERATIVE_AI_API_KEY=
GROQ_API_KEY=

# Model ids (never hard-coded in source — set them here)
WRITER_MODEL=gemini-3.5-flash-lite
CRITIC_MODEL=openai/gpt-oss-20b

# OpenAI Images — used when a campaign has no uploaded photo.
# Square size only: gpt-image-1.5 is capped at 1024x1024 here
# (1023x1024 is not a valid OpenAI size).
OPENAI_API_KEY=
IMAGE_MODEL=gpt-image-1.5
IMAGE_SIZE=1024x1024

# Bluesky publishing — create an app password at bsky.app → Settings → App Passwords
BLUESKY_HANDLE=yourhandle.bsky.social
BLUESKY_APP_PASSWORD=

# Tavily — live research before LinkedIn drafts. Optional; skipped if unset.
TAVILY_API_KEY=

# LinkedIn OAuth — Share on LinkedIn + Sign In with LinkedIn (OpenID).
# Add this redirect URL in the LinkedIn app Auth tab:
#   {APP_URL}/api/integrations/linkedin/callback
# Scopes requested: openid profile email w_member_social
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Optional. Shared password for `npm run bootstrap-demo-users`.
# Default (if unset): Loopwave-demo-1
# DEMO_PASSWORD=
