# Postgres (see docker-compose.dev.yml for local, docker-compose.yml for prod)
DATABASE_URL=postgres://app:app@localhost:5432/distribution
DB_PASSWORD=change-me

# Vercel AI SDK providers
GOOGLE_GENERATIVE_AI_API_KEY=
GROQ_API_KEY=

# Model ids (never hard-coded in source — set them here)
WRITER_MODEL=gemini-1.5-flash
CRITIC_MODEL=llama-3.3-70b-versatile

# Bluesky publishing (used later)
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
